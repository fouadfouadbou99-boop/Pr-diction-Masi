with tab_backtest:

    bt, mae, rmse, r2, sigma = (
        walk_forward_validation(df)
    )

    c1, c2, c3 = st.columns(3)

    c1.metric(
        "MAE",
        round(mae,2)
    )

    c2.metric(
        "RMSE",
        round(rmse,2)
    )

    c3.metric(
        "R²",
        round(r2,3)
    )

    fig_bt = go.Figure()

    fig_bt.add_trace(
        go.Scatter(
            y=bt["Actual"],
            name="Réel"
        )
    )

    fig_bt.add_trace(
        go.Scatter(
            y=bt["Forecast"],
            name="Prévision"
        )
    )

    st.plotly_chart(
        fig_bt,
        use_container_width=True
    )
